 option(ALLOW_PORTABLE "Allow Cemu to be run in portable mode" ON)
 
+# ZephyrU: build the iOS platform target (libcemu_core equivalent + UIKit app)
+option(CEMU_IOS "Build Cemu for iOS (ZephyrU)" OFF)
+
+if (CEMU_IOS)
+	add_compile_definitions(CEMU_IOS=1)
+	# core headers reference the iOS platform overlay as "ios/platform/..."
+	include_directories(${CMAKE_CURRENT_SOURCE_DIR})
+	# desktop-only components are never used on iOS
+	set(ENABLE_WXWIDGETS OFF CACHE BOOL "" FORCE)
+	set(ENABLE_OPENGL OFF CACHE BOOL "" FORCE)
+	set(ENABLE_VULKAN OFF CACHE BOOL "" FORCE)
+	set(ENABLE_CUBEB OFF CACHE BOOL "" FORCE)
+	set(ENABLE_SDL OFF CACHE BOOL "" FORCE)
+	set(ENABLE_LIBUSB OFF CACHE BOOL "" FORCE)
+	set(ENABLE_HIDAPI OFF CACHE BOOL "" FORCE)
+	set(ENABLE_DISCORD_RPC OFF CACHE BOOL "" FORCE)
+	# On iOS all executables default to MACOSX_BUNDLE, which breaks the install()
+	# rules of third-party subprojects that do not set a BUNDLE DESTINATION
+	# (e.g. ZArchive's zarchiveTool). Our own app sets MACOSX_BUNDLE explicitly.
+	set(CMAKE_MACOSX_BUNDLE OFF)
+endif()
+
